{"_id":"page-section-about-bom-pa","_type":"pageSection","title":"BOM & Parents Association","pageSlug":"about","sectionKey":"bom-pa","body":[{"_key":"about-bom-pa-h2","_type":"block","style":"h2","markDefs":[],"children":[{"_key":"about-bom-pa-h2-s1","_type":"span","text":"BOM & Parents Association","marks":[]}]},{"_key":"about-bom-pa-h3-1","_type":"block","style":"h3","markDefs":[],"children":[{"_key":"about-bom-pa-h3-1-s1","_type":"span","text":"Board of Management","marks":[]}]},{"_key":"about-bom-pa-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-bom-pa-p1-s1","_type":"span","text":"Our Board of Management (BOM) consists of visionaries and professionals dedicated to the strategic growth of the school. They ensure that our resources are utilized effectively to provide the best environment for our learners.","marks":[]}]},{"_key":"about-bom-pa-li1","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li1-s1","_type":"span","text":"Strategic Development Oversight","marks":[]}]},{"_key":"about-bom-pa-li2","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li2-s1","_type":"span","text":"Financial Management & Transparency","marks":[]}]},{"_key":"about-bom-pa-li3","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li3-s1","_type":"span","text":"Infrastructure Planning","marks":[]}]},{"_key":"about-bom-pa-h3-2","_type":"block","style":"h3","markDefs":[],"children":[{"_key":"about-bom-pa-h3-2-s1","_type":"span","text":"Parents Association (PA)","marks":[]}]},{"_key":"about-bom-pa-p2","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-bom-pa-p2-s1","_type":"span","text":"The PA serves as a vital bridge between the school administration and our parents. Through regular meetings and collaborative projects, they ensure that the parent's voice is heard and acted upon.","marks":[]}]},{"_key":"about-bom-pa-quote","_type":"block","style":"blockquote","markDefs":[],"children":[{"_key":"about-bom-pa-quote-s1","_type":"span","text":"Education is a three-legged stool: The Teacher, The Student, and The Parent.","marks":[]}]}]}
{"_id":"page-section-about-overview","_type":"pageSection","title":"Overview & FAQs","pageSlug":"about","sectionKey":"overview","body":[{"_key":"about-overview-h2","_type":"block","style":"h2","markDefs":[],"children":[{"_key":"about-overview-h2-s1","_type":"span","text":"Overview & FAQs","marks":[]}]},{"_key":"about-overview-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-overview-p1-s1","_type":"span","text":"St Peter's Khwirale Senior School is a premier mixed day and boarding school located in the heart of Busia County. Since its inception, the school has been a beacon of academic excellence and character formation for students across the region.","marks":[]}]}]}
{"_id":"page-section-about-history","_type":"pageSection","title":"School History","pageSlug":"about","sectionKey":"history","body":[{"_key":"about-history-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-history-p1-s1","_type":"span","text":"Founded in 2005, St Peter's Khwirale Senior School began as a humble community initiative to bring quality senior education closer to the people of Busia. Over the decades, we have grown into a center of academic prowess, consistently ranking among the top schools in the region.","marks":[]}]},{"_key":"about-history-p2","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-history-p2-s1","_type":"span","text":"From our first graduating class to our current status as a regional giant, the journey has been marked by resilience and the unwavering support of the Khwirale community.","marks":[]}]}]}
{"_id":"page-section-about-service-charter","_type":"pageSection","title":"Service Charter","pageSlug":"about","sectionKey":"service-charter","body":[{"_key":"about-service-charter-h2","_type":"block","style":"h2","markDefs":[],"children":[{"_key":"about-service-charter-h2-s1","_type":"span","text":"Service Charter","marks":[]}]},{"_key":"about-service-charter-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-service-charter-p1-s1","_type":"span","text":"We commit to professional, efficient, and ethical service delivery to all our stakeholders.","marks":[]}]}]}
{"_id":"page-section-about-gallery","_type":"pageSection","title":"School Gallery","pageSlug":"about","sectionKey":"gallery","body":[{"_key":"about-gallery-h2","_type":"block","style":"h2","markDefs":[],"children":[{"_key":"about-gallery-h2-s1","_type":"span","text":"School Gallery","marks":[]}]},{"_key":"about-gallery-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-gallery-p1-s1","_type":"span","text":"Explore a glimpse of learning, leadership, activities, and daily school life at St Peter's Khwirale.","marks":[]}]}]}
{"_id":"page-section-about-alumni","_type":"pageSection","title":"Alumni Community","pageSlug":"about","sectionKey":"alumni","body":[{"_key":"about-alumni-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-alumni-p1-s1","_type":"span","text":"Our alumni are our greatest pride. Spread across the globe in various sectors, they continue to carry the \"Endeavour to Excel\" spirit.","marks":[]}]},{"_key":"about-alumni-p2","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-alumni-p2-s1","_type":"span","text":"The St Peter's Khwirale Senior School Alumni Association works to support current students through mentorship programs, scholarships, and infrastructure development.","marks":[]}]}]}
