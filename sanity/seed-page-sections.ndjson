{"_id":"page-section-about-bom-pa","_type":"pageSection","title":"BOM & Parents Association","pageSlug":"about","sectionKey":"bom-pa","body":[{"_key":"about-bom-pa-h2","_type":"block","style":"h2","markDefs":[],"children":[{"_key":"about-bom-pa-h2-s1","_type":"span","text":"BOM & Parents Association","marks":[]}]},{"_key":"about-bom-pa-h3-1","_type":"block","style":"h3","markDefs":[],"children":[{"_key":"about-bom-pa-h3-1-s1","_type":"span","text":"Board of Management","marks":[]}]},{"_key":"about-bom-pa-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-bom-pa-p1-s1","_type":"span","text":"Our Board of Management (BOM) consists of visionaries and professionals dedicated to the strategic growth of the school. They ensure that our resources are utilized effectively to provide the best environment for our learners.","marks":[]}]},{"_key":"about-bom-pa-li1","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li1-s1","_type":"span","text":"Strategic Development Oversight","marks":[]}]},{"_key":"about-bom-pa-li2","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li2-s1","_type":"span","text":"Financial Management & Transparency","marks":[]}]},{"_key":"about-bom-pa-li3","_type":"block","style":"normal","listItem":"bullet","markDefs":[],"children":[{"_key":"about-bom-pa-li3-s1","_type":"span","text":"Infrastructure Planning","marks":[]}]},{"_key":"about-bom-pa-h3-2","_type":"block","style":"h3","markDefs":[],"children":[{"_key":"about-bom-pa-h3-2-s1","_type":"span","text":"Parents Association (PA)","marks":[]}]},{"_key":"about-bom-pa-p2","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"about-bom-pa-p2-s1","_type":"span","text":"The PA serves as a vital bridge between the school administration and our parents. Through regular meetings and collaborative projects, they ensure that the parent's voice is heard and acted upon.","marks":[]}]},{"_key":"about-bom-pa-quote","_type":"block","style":"blockquote","markDefs":[],"children":[{"_key":"about-bom-pa-quote-s1","_type":"span","text":"Education is a three-legged stool: The Teacher, The Student, and The Parent.","marks":[]}]}]}
