{
  "name": "st-peters-khwirale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --ignore=tests/lighthouse.spec.js",
    "test:a11y": "playwright test tests/accessibility.spec.js --project=chromium",
    "test:perf": "playwright test tests/performance.spec.js --project=chromium",
    "test:seo": "playwright test tests/seo.spec.js --project=chromium",
    "test:content": "playwright test tests/content.spec.js --project=chromium",
    "test:lighthouse": "npm run build && playwright test tests/lighthouse.spec.js --project=chromium",
    "test:all": "npm run test:unit && npm run test:e2e",
    "sanity:dev": "node node_modules/sanity/bin/sanity dev",
    "sanity:deploy": "node node_modules/sanity/bin/sanity deploy"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.25.0",
    "buffer": "^6.0.3",
    "gray-matter": "^4.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^5.25.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "msw": "^2.14.6",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
